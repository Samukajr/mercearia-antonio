rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
        // Mesmo inquilino: o usuário dono do documento OU
        // usuário cuja ficha em /usuarios/{uid} tem userId igual ao userId do documento
        function sameTenant(docUserId) {
          return request.auth != null && (
            isProprietario() ||
            request.auth.uid == docUserId ||
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.userId == docUserId
          );
        }
    
    // Função auxiliar para obter role do usuário
    function getUserRole() {
      return request.auth.token.role;
    }
    
    // Função auxiliar para verificar se é proprietário
    function isProprietario() {
      return getUserRole() == 'proprietario';
    }
    
    // Função auxiliar para verificar se é gerente ou superior
    function isGerenteOuSuperior() {
      return getUserRole() in ['proprietario', 'gerente'];
    }
    
    // Produtos - controle por inquilino (tenant)
    match /produtos/{produtoId} {
      allow read: if sameTenant(resource.data.userId);
      allow create: if sameTenant(request.resource.data.userId) &&
                       getUserRole() in ['proprietario', 'gerente', 'operador_estoque'];
      allow update: if sameTenant(resource.data.userId) &&
                       getUserRole() in ['proprietario', 'gerente', 'operador_estoque'];
      allow delete: if sameTenant(resource.data.userId) && isGerenteOuSuperior();
    }
    
    // Vendas
    match /vendas/{vendaId} {
      allow read: if sameTenant(resource.data.userId);
      allow create: if sameTenant(request.resource.data.userId) &&
                       getUserRole() in ['proprietario', 'gerente', 'operador_caixa'];
      allow update: if sameTenant(resource.data.userId) && isGerenteOuSuperior();
      allow delete: if sameTenant(resource.data.userId) && isProprietario();
    }
    
    // Movimentações de caixa
    match /movimentacoes/{movimentacaoId} {
      allow read: if sameTenant(resource.data.userId);
      allow create: if sameTenant(request.resource.data.userId) &&
                       getUserRole() in ['proprietario', 'gerente', 'operador_caixa'];
      allow update: if sameTenant(resource.data.userId) && isGerenteOuSuperior();
      allow delete: if sameTenant(resource.data.userId) && isGerenteOuSuperior();
    }
    
    // Usuários - apenas proprietário pode gerenciar
    match /usuarios/{usuarioId} {
      allow read: if sameTenant(resource.data.userId) || isProprietario();
      allow create: if request.auth != null && isProprietario();
      allow update: if sameTenant(resource.data.userId) || isProprietario();
      allow delete: if request.auth != null && isProprietario();
    }
    
    // Configurações da loja - apenas proprietário
    match /configuracoes/{configId} {
      allow read: if sameTenant(resource.data.userId);
      allow write: if sameTenant(resource.data.userId) && isProprietario();
    }
    
    // Coleção lojas (configurações) - doc ID = userId
    match /lojas/{lojaId} {
      allow read: if sameTenant(lojaId);
      allow write: if sameTenant(lojaId) && isProprietario();
    }
    
    // Audit logs - apenas leitura para proprietário
    match /auditLogs/{logId} {
      allow read: if request.auth != null && isProprietario();
      allow create: if request.auth != null;
    }
    
    // Backups - apenas proprietário
    match /backups/{backupId} {
      allow read, write: if request.auth != null && isProprietario();
    }
    
    // Consentimentos LGPD - cada usuário registra seu próprio
    match /lgpdConsents/{consentId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isProprietario());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (request.auth.uid == resource.data.userId || isProprietario());
      allow delete: if request.auth != null && isProprietario();
    }
  }
}
