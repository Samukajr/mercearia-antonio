rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para obter role do usuário
    function getUserRole() {
      return request.auth.token.role;
    }
    
    // Função auxiliar para verificar se é proprietário
    function isProprietario() {
      return getUserRole() == 'proprietario';
    }
    
    // Função auxiliar para verificar se é gerente ou superior
    function isGerenteOuSuperior() {
      return getUserRole() in ['proprietario', 'gerente'];
    }
    
    // Produtos - todos podem ler seus próprios produtos
    match /produtos/{produtoId} {
      allow read: if request.auth != null && 
                     (resource == null || request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId &&
                       getUserRole() in ['proprietario', 'gerente', 'operador_estoque'];
      allow update: if request.auth != null && 
                       request.auth.uid == resource.data.userId &&
                       getUserRole() in ['proprietario', 'gerente', 'operador_estoque'];
      allow delete: if request.auth != null && 
                       request.auth.uid == resource.data.userId &&
                       isGerenteOuSuperior();
    }
    
    // Vendas
    match /vendas/{vendaId} {
      allow read: if request.auth != null && 
                     (resource == null || request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId &&
                       getUserRole() in ['proprietario', 'gerente', 'operador_caixa'];
      allow update: if request.auth != null && 
                       request.auth.uid == resource.data.userId &&
                       isGerenteOuSuperior();
      allow delete: if request.auth != null && 
                       request.auth.uid == resource.data.userId &&
                       isProprietario();
    }
    
    // Movimentações de caixa
    match /movimentacoes/{movimentacaoId} {
      allow read: if request.auth != null && 
                     (resource == null || request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId &&
                       getUserRole() in ['proprietario', 'gerente', 'operador_caixa'];
      allow update: if request.auth != null && 
                       request.auth.uid == resource.data.userId &&
                       isGerenteOuSuperior();
      allow delete: if request.auth != null && 
                       request.auth.uid == resource.data.userId &&
                       isGerenteOuSuperior();
    }
    
    // Usuários - apenas proprietário pode gerenciar
    match /usuarios/{usuarioId} {
      allow read: if request.auth != null && 
                     (request.auth.uid == resource.data.userId || isProprietario());
      allow create: if request.auth != null && isProprietario();
      allow update: if request.auth != null && 
                       (request.auth.uid == resource.data.userId || isProprietario());
      allow delete: if request.auth != null && isProprietario();
    }
    
    // Configurações da loja - apenas proprietário
    match /configuracoes/{configId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && 
                      request.auth.uid == resource.data.userId && 
                      isProprietario();
    }
    
    // Coleção lojas (configurações) - doc ID = userId
    match /lojas/{lojaId} {
      allow read: if request.auth != null && request.auth.uid == lojaId;
      allow write: if request.auth != null && 
                      request.auth.uid == lojaId && 
                      isProprietario();
    }
    
    // Audit logs - apenas leitura para proprietário
    match /auditLogs/{logId} {
      allow read: if request.auth != null && isProprietario();
      allow create: if request.auth != null;
    }
    
    // Backups - apenas proprietário
    match /backups/{backupId} {
      allow read, write: if request.auth != null && isProprietario();
    }
  }
}
